{
  "name": "chapel-hope-live",
  "private": true,
  "version": "1.2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm run dev -w @chapel/server\" \"npm run dev -w @chapel/client\"",
    "build": "npm run typecheck && npm run build -w @chapel/client && npm run build -w @chapel/server",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "tsx scripts/browser-smoke.ts",
    "start": "npm run start -w @chapel/server",
    "test:visual": "node --import tsx scripts/visual-v12.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
